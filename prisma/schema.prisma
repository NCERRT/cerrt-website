// CERRT database schema
// Migrated from Convex. See MIGRATION_PLAN.md for context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum AdvisoryCategory {
  individuals
  organizations
  kids
  general
}

enum Severity {
  critical
  high
  medium
  low
}

enum FileType {
  pdf
  image
}

enum AdvisoryType {
  standard
  poster
}

enum IncidentStatus {
  new
  reviewing
  resolved
  closed
}

enum InquiryType {
  general
  incident
  advisory
  training
  partnership
}

enum ContactStatus {
  new
  read
  responded
  closed
}

enum SenderType {
  analyst
  mda_poc
}

enum SubmissionChannel {
  web
  email
  api
}

enum MdaRegistrationStatus {
  pending
  approved
  rejected
}

// ============================================================
// Models
// ============================================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  passwordHash          String
  mustChangePassword    Boolean   @default(false)
  role                  String    @default("admin") // "superadmin" | "admin"
  isDeactivated         Boolean   @default(false)   // ← NEW: account suspension
  tempPasswordExpiresAt DateTime? // null = no temp password; set when invited
  createdById           String?   // null = seeded via CLI
  createdAt             DateTime  @default(now())

  sessions            Session[]
  advisories          Advisory[]
  defacementStats     DefacementStat[]
  reviewedReports     IncidentReport[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Advisory {
  id                 String           @id @default(cuid())
  slug               String?          @unique
  title              String
  description        String           // Deprecated: migrating to overview
  type               AdvisoryType     @default(standard)
  overview           String?
  impact             String?
  affectedProducts   String[]
  recommendedActions String[]
  references         String[]
  tags               String[]
  category           AdvisoryCategory
  severity           Severity
  advisoryId         String           @unique // business identifier, e.g. NCA-130226-01
  date               DateTime
  fileKey            String? // MinIO object key
  fileType           FileType?
  fileName           String?
  fileSize           Int?
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  createdBy   User         @relation(fields: [createdById], references: [id])
  posterItems PosterItem[]

  @@index([category])
  @@index([date])
  @@map("advisories")
}

model PosterItem {
  id         String   @id @default(cuid())
  advisoryId String
  imageKey   String
  fileName   String
  fileSize   Int
  order      Int
  createdAt  DateTime @default(now())

  advisory Advisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)

  @@index([advisoryId])
  @@map("poster_items")
}

model DefacementStat {
  id          String   @id @default(cuid())
  year        Int
  month       Int // 1-12
  incidents   Int
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([year, month])
  @@index([year])
  @@map("defacement_stats")
}

model IncidentReport {
  id           String         @id @default(cuid())
  trackingCode String?        @unique // human-friendly public lookup code (CERRT-XXXX-XXXX)
  title        String?
  type         String
  description  String
  contactName  String
  contactEmail String
  contactPhone String
  organization String
  severity     Severity
  status       IncidentStatus @default(new)
  submittedAt  DateTime       @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  notes        String?
  ticketId          String?
  thehiveCaseId     String?
  hiveStatus        String?
  hiveSummary       String?
  hiveType          String?
  hiveSeverity      String?
  submissionChannel SubmissionChannel @default(web)
  emailMessageId    String?           @unique
  mdaOrganizationId String?
  updatedAt         DateTime?         @updatedAt

  reviewedBy      User?            @relation(fields: [reviewedById], references: [id])
  mdaOrganization MdaOrganization? @relation(fields: [mdaOrganizationId], references: [id])

  secureTokens       SecureToken[]
  caseCommunications CaseCommunication[]

  @@index([status])
  @@index([submittedAt])
  @@index([submissionChannel])
  @@index([mdaOrganizationId])
  @@map("incident_reports")
}

model SecureToken {
  id          String   @id @default(cuid())
  token       String   @unique
  cerrtCaseId String
  taskLogId   String   @unique
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  incidentReport IncidentReport @relation(fields: [cerrtCaseId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([cerrtCaseId])
  @@map("secure_tokens")
}

model CaseCommunication {
  id             String     @id @default(cuid())
  cerrtCaseId    String
  thehiveCaseId  String?
  senderType     SenderType
  messageBody    String
  attachmentKey  String?
  attachmentName String?
  attachments    Json?      // [{ key: string, name: string }]
  isSyncedToHive Boolean    @default(false)
  createdAt      DateTime   @default(now())

  incidentReport IncidentReport @relation(fields: [cerrtCaseId], references: [id], onDelete: Cascade)

  @@index([cerrtCaseId])
  @@index([createdAt])
  @@index([isSyncedToHive])
  @@map("case_communications")
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@index([subscribedAt])
  @@map("subscribers")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of the raw token
  expiresAt DateTime
  usedAt    DateTime? // null until consumed
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ContactSubmission {
  id           String        @id @default(cuid())
  inquiryType  InquiryType
  name         String
  email        String
  phone        String?
  organization String?
  subject      String
  message      String
  submittedAt  DateTime      @default(now())
  status       ContactStatus @default(new)

  @@index([status])
  @@index([submittedAt])
  @@map("contact_submissions")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  
  // Actor metadata
  userId      String?
  userEmail   String?
  userName    String?
  
  // Action details
  action      String   // e.g. "AUTH_LOGIN_FAILURE", "USER_INVITE"
  description String   // e.g. "Jane Doe was invited to join as an administrator."
  
  // Target metadata
  targetId    String?
  targetType  String?
  
  // Technical metadata
  ipAddress   String?
  metadata    Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([keyHash])
  @@map("api_keys")
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   // SHA-256 of the 6-digit numeric code
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([otpHash])
  @@map("email_otps")
}

// ============================================================
// MDA Portal Models
// ============================================================

model MdaRegistration {
  id               String                  @id @default(cuid())
  organizationName String
  acronym          String?
  sector           String?
  contactName      String
  contactEmail     String                  // unique per email
  jobTitle         String
  phone            String?
  passwordHash     String                  // bcrypt hash (copied to MdaAccount on approval)
  emailDomain      String                  // e.g. "moj.zamfara.gov.ng"
  status           MdaRegistrationStatus   @default(pending)
  reviewedById     String?                 // CERRT admin who reviewed
  reviewNote       String?                 // reason for rejection
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([contactEmail])
  @@index([status])
  @@index([emailDomain])
  @@map("mda_registrations")
}

model MdaOrganization {
  id              String   @id @default(cuid())
  name            String
  acronym         String?
  sector          String?
  verifiedDomains String[]                 // ["moj.zamfara.gov.ng", "zamfara.gov.ng"]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         MdaAccount?              // exactly 1 account per org
  incidentReports IncidentReport[]

  @@map("mda_organizations")
}

model MdaAccount {
  id                  String          @id @default(cuid())
  email               String          @unique
  contactName         String
  jobTitle            String?
  phone               String?
  passwordHash        String
  mustChangePassword  Boolean         @default(false)
  isActive            Boolean         @default(true)
  mdaOrganizationId   String          @unique    // enforces 1:1 relationship
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  mdaOrganization MdaOrganization @relation(fields: [mdaOrganizationId], references: [id])
  sessions        MdaSession[]

  @@map("mda_accounts")
}

model MdaSession {
  id           String   @id @default(cuid())
  mdaAccountId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  mdaAccount MdaAccount @relation(fields: [mdaAccountId], references: [id], onDelete: Cascade)

  @@index([mdaAccountId])
  @@map("mda_sessions")
}

